{
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "allow": [
      "Read(node_modules/**)"
    ],
    "deny": [
      "Bash(npm publish *)",
      "Bash(npm login *)",
      "Bash(npm adduser *)",
      "Bash(npm config set registry *)",
      "Bash(yarn publish *)",
      "Bash(pnpm publish *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/id_rsa*)",
      "Read(**/*.pem)",
      "Read(**/.netrc)",
      "Read(~/.netrc)",
      "Read(**/.aws/**)",
      "Read(~/.aws/**)",
      "Read(**/.ssh/**)",
      "Read(~/.ssh/**)"
    ]
  },
  "enabledPlugins": {
    "claude-tweaks@claude-tweaks-marketplace": true,
    "superpowers@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "impeccable@impeccable": true
  },
  "extraKnownMarketplaces": {
    "claude-tweaks-marketplace": {
      "source": {
        "source": "github",
        "repo": "thn-inc/claude-tweaks-marketplace"
      }
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    }
  }
}
