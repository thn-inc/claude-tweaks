.claude/worktrees/
.claude/settings.local.json
.superpowers/sdd/
node_modules/
/package-lock.json
.DS_Store
.claude-tweaks/artifacts/
.claude-tweaks/pipelines/*
!.claude-tweaks/pipelines/*/
.claude-tweaks/pipelines/*/*
!.claude-tweaks/pipelines/*/work/
!.claude-tweaks/pipelines/*/work/**
!.claude-tweaks/pipelines/*/spec-*/
.claude-tweaks/pipelines/*/spec-*/*
!.claude-tweaks/pipelines/*/spec-*/work/
!.claude-tweaks/pipelines/*/spec-*/work/**
# Tidy standalone runs commit their own audit files (#1493) — top-level pipelines
# depth only, never spec-*/-nested (a tidy standalone run is never spec-nested).
!.claude-tweaks/pipelines/*-tidy-standalone*/decisions.md
!.claude-tweaks/pipelines/*-tidy-standalone*/report.md
!.claude-tweaks/pipelines/*-tidy-standalone*/staged/
!.claude-tweaks/pipelines/*-tidy-standalone*/staged/**
# Sweep standalone runs share the same shape (#1494) — its Step 1 runs tidy
# inside a `*-sweep-standalone*` run dir, whose Step 7.5 commits the same
# decisions.md/report.md/staged/** residue there instead.
!.claude-tweaks/pipelines/*-sweep-standalone*/decisions.md
!.claude-tweaks/pipelines/*-sweep-standalone*/report.md
!.claude-tweaks/pipelines/*-sweep-standalone*/staged/
!.claude-tweaks/pipelines/*-sweep-standalone*/staged/**
!.claude-tweaks/pipelines/archive/*/
.claude-tweaks/pipelines/archive/*/*
!.claude-tweaks/pipelines/archive/*/work/
!.claude-tweaks/pipelines/archive/*/work/**
!.claude-tweaks/pipelines/archive/*/spec-*/
.claude-tweaks/pipelines/archive/*/spec-*/*
!.claude-tweaks/pipelines/archive/*/spec-*/work/
!.claude-tweaks/pipelines/archive/*/spec-*/work/**
.claude-tweaks/research/
# Local finding caches — all four health skills write .claude-tweaks/{skill}/cache.json
# (plugin/bin/lib/health-core/cache.js). Listed individually, never as a blanket
# .claude-tweaks/ rule, because .claude-tweaks/routines/*.yml is meant to be committed.
.claude-tweaks/code-health/
.claude-tweaks/harness-health/
.claude-tweaks/journey-health/
.claude-tweaks/docs-health/
# feedback/ and declined-learning/ below are local state too (a watermark file and
# plugin/bin/lib/declined-learning/store.js's store.json, not health-skill cache.json), listed
# individually for the same reason as the four health skills above.
.claude-tweaks/feedback/
.claude-tweaks/declined-learning/
.claude-tweaks/routine-environment-cache.yml
.claude-tweaks/init-state.yml
.claude-tweaks/reconcile-cache.json
.claude-tweaks/reconcile-background-status.json
.claude-tweaks/wrap-up-outcomes.tsv
# Captured playwright-cli session-state files (cookies/localStorage) for QA story auth —
# local secrets, never committed. See skills/stories/auth-resolution.md.
.claude-tweaks/auth-state/
**/__pycache__/
