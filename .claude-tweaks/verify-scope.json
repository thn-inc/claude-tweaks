{
  "checks": {
    "tests": {
      "tests": "node tools/run-tests.js --full",
      "journeys": "node --test tests/argument-hint-mirrors.test.js tests/close-out-ready-run-conformance.test.js tests/dispatch-named-form-exclusion-reasons.test.js tests/impeccable-retired-scripts-sweep.test.js tests/plan-citations-resolve.test.js tests/settle-blocker-landing-stop-conformance.test.js tests/tidy-release-note-repair-conformance.test.js tests/tidy-report-rules.test.js tests/timing-prose-conformance.test.js"
    }
  },
  "retry": { "tests": "node --test {file}", "journeys": "node --test {file}" },
  "flaky": {
    "files": ["tests/bin-lib/log-decision/append.test.js", "tests/bin-lib/verify/cli.test.js", "tests/bin-lib/verify/cli-stamp-discovery.test.js", "tests/bin-lib/verify/cli-flaky-preexisting.test.js", "tests/bin-lib/verify/cli-baseline.test.js", "tests/bin-lib/verify/cli-baseline-verdicts.test.js", "tests/bin-lib/verify/cli-scope-integration.test.js", "tests/bin-lib/verify/cli-slot.test.js", "tests/bin-lib/verify/cli-slot-queue.test.js", "tests/bin-lib/verify/cli-slot-signals.test.js","tests/bin-lib/gif/palette.test.js", "tests/statusline.test.js", "tests/bin-lib/staged-patch/cli.test.js", "tests/bin-lib/staged-patch/stack-check.test.js", "tests/console-execute.test.js"],
    "maxRetries": 1
  },
  "ci": { "tests": { "workflow": "test.yml", "job": "test" } },
  "localRuns": "on-request",
  "impact": {
    "suite": "tests",
    "command": "node tools/run-tests.js --files-from {files}",
    "tests": ["tests/**/*.test.js", "tools/upstream-drift/tests/**/*.test.js"],
    "maxAgeCommits": 200,
    "fetch": "node tools/test-impact.js fetch"
  },
  "rules": [
    { "match": "tools/run-tests.js", "suites": "*", "static": true },
    { "match": "tools/test-impact/**", "suites": "*", "static": true },
    { "match": "plugin/**", "impact": true, "suites": "*", "static": true },
    { "match": "tests/**", "impact": true, "suites": "*", "static": true },
    { "match": "tools/**", "impact": true, "suites": "*", "static": true },
    { "match": ".claude/**", "impact": true, "suites": "*", "static": true },
    { "match": ".github/workflows/**", "impact": true, "suites": "*", "static": true },
    { "match": "perf/**", "impact": true, "suites": "*", "static": true },
    { "match": ".release-please-manifest.json", "impact": true, "suites": "*", "static": true },
    { "match": "docs/journeys/**", "suites": ["journeys"], "static": false },
    { "match": "docs/plans/*-ledger.md", "suites": [], "static": false },
    { "match": ".claude-tweaks/pipelines/**", "suites": [], "static": false },
    { "match": "docs/superpowers/plans/**", "suites": [], "static": false },
    { "match": "docs/superpowers/specs/**", "suites": [], "static": false },
    { "match": "docs/**", "impact": true, "suites": "*", "static": true },
    { "match": "*.md", "impact": true, "suites": "*", "static": true }
  ]
}
